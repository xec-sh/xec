{
  "name": "xec-sh",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo build --filter=@xec-sh/cli",
    "build:full": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "eslint \"{apps,packages}/**/*.{js,jsx,ts,tsx}\" \"website/src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"{apps,packages}/**/*.{js,jsx,ts,tsx}\" \"website/src/**/*.{js,jsx,ts,tsx}\"",
    "lint:print": "eslint --print-config packages/core/src/index.ts > eslint-show-config.json",
    "fm:check": "prettier --check \"{apps,packages}/**/*.{js,jsx,ts,tsx}\"",
    "fm:fix": "prettier --write \"{apps,packages}/**/*.{js,jsx,ts,tsx}\"",
    "fix:all": "pnpm run lint:fix && pnpm run fm:fix",
    "cleanup": "find . -name \"node_modules\" -type d -prune -exec rm -rf '{}' +",
    "release": "xec release",
    "link:global": "cd apps/xec && pnpm build && npm link",
    "unlink:global": "cd apps/xec && npm unlink -g @xec-sh/cli",
    "docs:check": "node scripts/check-doc-examples.mjs",
    "docs:start": "cd website && pnpm start",
    "docs:build": "cd website && pnpm build",
    "docs:serve": "cd website && pnpm serve",
    "docs:deploy": "cd website && pnpm deploy",
    "typecheck": "pnpm -r run typecheck",
    "check:lockfile": "pnpm install --frozen-lockfile --lockfile-only"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/add": "^2.0.3",
    "@types/debug": "^4.1.13",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@xec-sh/kit": "workspace:*",
    "add": "^2.0.9",
    "debug": "^4.4.3",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "glob": "^14.0.3",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "semver": "^7.8.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.72.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-import-x": "^4.17.1"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12.16.1"
  }
}
