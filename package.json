{
  "name": "xec-sh",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo build --filter=@xec-sh/cli",
    "build:full": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "eslint \"{apps,packages}/**/*.{js,jsx,ts,tsx}\" \"website/src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"{apps,packages}/**/*.{js,jsx,ts,tsx}\" \"website/src/**/*.{js,jsx,ts,tsx}\"",
    "lint:print": "eslint --print-config eslint.config.mjs > eslint-show-config.json",
    "fm:check": "prettier --check \"{apps,packages}/**/*.{js,jsx,ts,tsx}\"",
    "fm:fix": "prettier --write \"{apps,packages}/**/*.{js,jsx,ts,tsx}\"",
    "fix:all": "pnpm run lint:fix && pnpm run fm:fix",
    "cleanup": "find . -name \"node_modules\" -type d -prune -exec rm -rf '{}' +",
    "release": "xec release",
    "link:global": "cd apps/xec && pnpm build && npm link",
    "unlink:global": "cd apps/xec && npm unlink -g @xec-sh/cli",
    "docs:start": "cd website && pnpm start",
    "docs:build": "cd website && pnpm build",
    "docs:serve": "cd website && pnpm serve",
    "docs:deploy": "cd website && pnpm deploy",
    "typecheck": "pnpm -r run typecheck",
    "check:lockfile": "pnpm install --frozen-lockfile --lockfile-only"
  },
  "devDependencies": {
    "@xec-sh/kit": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/add": "^2.0.3",
    "@types/debug": "^4",
    "@types/node": "^25.5.0",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "8.57.0",
    "@typescript-eslint/parser": "8.57.0",
    "add": "^2.0.6",
    "debug": "^4.4.3",
    "eslint": "10.0.3",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.6.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "glob": "^13.0.6",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "semver": "^7.7.4",
    "ts-loader": "9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "turbo": "^2.8.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.57.0"
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "ssh2",
      "cpu-features",
      "node-pty"
    ],
    "overrides": {
      "brace-expansion@1": ">=1.1.18 <2.0.0",
      "brace-expansion@2": ">=2.0.3 <3.0.0",
      "brace-expansion@>=3.0.0 <5.0.9": ">=5.0.9 <6.0.0",
      "fast-uri@3": ">=3.1.5 <4.0.0",
      "js-yaml@3": ">=3.15.0 <4.0.0",
      "js-yaml@4": ">=4.3.0 <5.0.0",
      "lodash@4": ">=4.18.0 <5.0.0",
      "lodash-es@4": ">=4.18.0 <5.0.0",
      "minimatch@3": ">=3.1.4 <4.0.0",
      "node-forge@<1.4.0": ">=1.4.0 <2.0.0",
      "path-to-regexp@0": ">=0.1.13 <0.2.0",
      "postcss@8": ">=8.5.18 <9.0.0",
      "serialize-javascript@<=7.0.2": ">=7.0.3 <8.0.0",
      "sharp@<0.35.0": ">=0.35.0 <0.36.0",
      "shell-quote@<=1.8.4": ">=1.9.0 <2.0.0",
      "svgo@3": ">=3.3.4 <4.0.0",
      "@babel/plugin-transform-modules-systemjs@7": ">=7.29.4 <8.0.0",
      "undici@7": ">=7.29.0 <8.0.0",
      "websocket-driver@<0.7.5": ">=0.7.5 <0.8.0",
      "picomatch@>=2.0.0 <2.3.2": ">=2.3.2 <3.0.0",
      "ws@>=7.0.0 <7.5.11": ">=7.5.11 <8.0.0",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0 <9.0.0",
      "mermaid@11": ">=11.15.0 <12.0.0",
      "dompurify@3": ">=3.4.12 <4.0.0",
      "webpack-dev-server@5": ">=5.2.6 <6.0.0",
      "qs@>=6.11.1 <6.15.2": ">=6.15.2 <7.0.0",
      "uuid@<11.1.1": ">=11.1.1 <12.0.0",
      "joi@17": ">=17.13.4 <18.0.0",
      "http-proxy-middleware@2": ">=2.0.10 <3.0.0",
      "follow-redirects@1": ">=1.16.0 <2.0.0",
      "launch-editor@2": ">=2.14.1 <3.0.0",
      "body-parser@1": ">=1.20.6 <2.0.0",
      "@babel/core@7": ">=7.29.6 <8.0.0",
      "micromatch>picomatch": ">=4.0.4 <5.0.0",
      "ajv@8": ">=8.18.0 <9.0.0",
      "esbuild@<0.28.1": ">=0.28.1 <0.29.0"
    }
  }
}
