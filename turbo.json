{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@xec-sh/website#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "build/**"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^test"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  },
  "globalDependencies": [
    "tsconfig.json",
    ".xec/commands/package.ts",
    ".xec/lib/package-build.ts",
    ".xec/lib/typescript-compiler.js",
    ".xec/ssh-transport-policy.json",
    ".xec/lib/ssh-transport.js"
  ]
}
