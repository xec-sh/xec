{
  "name": "@xec-sh/testing",
  "version": "0.10.1",
  "description": "Docker, SSH, and kind test fixtures for Xec integration tests",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist node_modules/.tmp/tsconfig.tsbuildinfo && tsc",
    "clean": "rm -rf dist node_modules/.tmp/tsconfig.tsbuildinfo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "xec",
    "test",
    "utils",
    "docker",
    "kubernetes"
  ],
  "author": "LuxQuant",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "docker",
    "docker-ssh-manager.sh"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xec-sh/xec.git",
    "directory": "packages/testing"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
