{
  "name": "@xec-sh/testing",
  "version": "0.11.5",
  "description": "Docker, SSH, and kind test fixtures for Xec integration tests",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "clean": "node ../../scripts/build-package.mjs --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "xec",
    "test",
    "utils",
    "docker",
    "kubernetes"
  ],
  "author": "LuxQuant",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "docker",
    "docker-ssh-manager.sh"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xec-sh/xec.git",
    "directory": "packages/testing"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "peerDependencies": {
    "vitest": "^5.1.0"
  }
}
