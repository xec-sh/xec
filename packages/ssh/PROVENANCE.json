  "adaptation": {
    "scope": "Private ESM transport engine; no ssh2 public API compatibility or runtime dependency",
    "sourceFixes": [
      "receive-window and packet-size enforcement",
      "outgoing WINDOW_ADJUST uint32 overflow rejection",
      "zero-packet open rejection",
      "pending channel write settlement",
      "SFTP lifecycle cleanup and exactly one acknowledged CLOSE",
      "automatic rekey by byte/packet/time budget and bounded queue/deadline",
      "exact safe-number SFTP decoding with bounded fields and request settlement on malformed replies"
    ],
    "replacements": {
      "crypto": "Runtime AES-GCM; optional OpenSSH ChaCha only with native raw ChaCha20 and Poly1305",
      "keyParser": "Native KeyObject PEM/JWK and bounded OpenSSH container decoding",
      "agent": "Bounded OpenSSH agent client framing with verified signature algorithm",
      "packet": "Uncompressed SSH packets; no runtime-private zlib APIs"
    },
    "exclusions": [
      "SHA-1/DSA/CBC transport algorithms",
      "DH group exchange and obsolete vendor branches",
      "PuTTY/PPK and RFC4716 key containers",
      "certificate and security-key variants not explicitly negotiated"
    ]
  },
