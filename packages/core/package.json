{
  "name": "@xec-sh/core",
  "version": "0.10.1",
  "description": "One TypeScript API for commands across local shells, SSH hosts, Docker containers, and Kubernetes pods",
  "author": "LuxQuant",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "keywords": [
    "shell",
    "command-execution",
    "ssh",
    "docker",
    "kubernetes",
    "automation",
    "typescript",
    "javascript",
    "devops",
    "orchestration",
    "template-literals",
    "streaming",
    "connection-pooling",
    "error-handling",
    "parallel-execution",
    "file-transfer",
    "port-forwarding",
    "tunnels",
    "container-management",
    "remote-execution",
    "process-management",
    "infrastructure-automation",
    "deployment",
    "ci-cd",
    "system-administration"
  ],
  "scripts": {
    "build": "rm -rf dist node_modules/.tmp/tsconfig.tsbuildinfo && tsc",
    "test": "vitest run",
    "test:unit": "vitest run test/unit/",
    "test:integration": "vitest run test/integration/",
    "test:ssh": "vitest run test/integration/ssh-",
    "test:docker": "vitest run test/integration/docker-",
    "test:k8s": "vitest run test/integration/kubernetes-",
    "test:e2e": "vitest run test/e2e/",
    "test:property": "vitest run test/property/",
    "docker:start": "../testing/docker-ssh-manager.sh start",
    "docker:stop": "../testing/docker-ssh-manager.sh stop",
    "docker:status": "../testing/docker-ssh-manager.sh status",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.0",
    "@types/ssh2": "^1.15.5",
    "@xec-sh/testing": "workspace:*",
    "dockerode": "^4.0.9",
    "node-pty": "^1.0.0",
    "ssh2-streams": "^0.4.10",
    "@types/ssh2-streams": "^0.1.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xec-sh/xec.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/xec-sh/xec/issues"
  },
  "homepage": "https://xec.sh",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
