{
  "name": "@xec-sh/ops",
  "version": "0.11.1",
  "description": "DevOps operations library \u2014 deploy, health checks, pipelines, discovery, workflows",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./deploy": {
      "types": "./dist/deploy/index.d.ts",
      "import": "./dist/deploy/index.js"
    },
    "./health": {
      "types": "./dist/health/index.d.ts",
      "import": "./dist/health/index.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline/index.d.ts",
      "import": "./dist/pipeline/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow/index.d.ts",
      "import": "./dist/workflow/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "import": "./dist/discovery/index.js"
    },
    "./retry": {
      "types": "./dist/retry/index.d.ts",
      "import": "./dist/retry/index.js"
    },
    "./completion": {
      "types": "./dist/completion/index.d.ts",
      "import": "./dist/completion/index.js"
    },
    "./config/*": {
      "types": "./dist/config/*.d.ts",
      "import": "./dist/config/*.js"
    },
    "./secrets/*": {
      "types": "./dist/secrets/*.d.ts",
      "import": "./dist/secrets/*.js"
    },
    "./api/*": {
      "types": "./dist/api/*.d.ts",
      "import": "./dist/api/*.js"
    },
    "./adapters/*": {
      "types": "./dist/adapters/*.d.ts",
      "import": "./dist/adapters/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "rm -rf dist node_modules/.tmp/tsconfig.tsbuildinfo && tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@xec-sh/core": "workspace:*",
    "@xec-sh/kit": "workspace:*",
    "@xec-sh/loader": "workspace:*",
    "dotenv": "^18.0.9",
    "fs-extra": "^11.4.1",
    "glob": "^14.0.3",
    "js-yaml": "^5.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/ssh2": "^1.15.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "keywords": [
    "devops",
    "deploy",
    "pipeline",
    "workflow",
    "health-check",
    "orchestration",
    "automation",
    "infrastructure",
    "ci-cd"
  ],
  "author": "LuxQuant",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xec-sh/xec.git",
    "directory": "packages/ops"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
