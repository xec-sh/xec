{
  "name": "@xec-sh/kit",
  "version": "0.11.1",
  "description": "Terminal prompts, spinners, tables, and colors for command-line applications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xec-sh/xec",
    "directory": "packages/kit"
  },
  "bugs": {
    "url": "https://github.com/xec-sh/xec/issues"
  },
  "homepage": "https://github.com/xec-sh/xec/tree/main/packages/kit#readme",
  "files": [
    "dist",
    "!dist/**/*.map",
    "src",
    "LICENSE",
    "NOTICE"
  ],
  "author": {
    "name": "Xec Contributors"
  },
  "license": "MIT",
  "keywords": [
    "ask",
    "cli",
    "command-line",
    "command",
    "input",
    "interact",
    "interface",
    "menu",
    "prompt",
    "prompts",
    "stdin",
    "ui",
    "terminal",
    "tui",
    "xec"
  ],
  "scripts": {
    "build": "rm -rf dist node_modules/.tmp/tsconfig.tsbuildinfo && bun scripts/build.ts",
    "build:watch": "bun scripts/build.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "FORCE_COLOR=1 vitest run",
    "test:watch": "FORCE_COLOR=1 vitest watch",
    "prettier:write": "prettier --write .",
    "prettier:check": "prettier --check .",
    "clean": "rm -rf dist node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "sisteransi": "^2.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "memfs": "^4.80.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5",
    "vitest-ansi-serializer": "^0.4.0",
    "zod": "^4.6.7",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.2.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100
  }
}
