{
  "name": "@xec-sh/website",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "Xec documentation, built with Lumen and Prism",
  "scripts": {
    "start": "lumen dev",
    "build": "xec run scripts/build.ts",
    "serve": "lumen serve",
    "typecheck": "tsc6 --noEmit",
    "check:routes": "node scripts/check-routes.js",
    "test:browser": "playwright test --workers=1",
    "test:examples": "node --test scripts/test/cli-examples.test.js"
  },
  "dependencies": {
    "@omnitron-dev/lumen": "0.4.8",
    "@omnitron-dev/lumen-ast": "0.4.8",
    "@omnitron-dev/lumen-ui": "0.4.8",
    "@omnitron-dev/prism": "0.4.8",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@xec-sh/cli": "0.12.0",
    "@xec-sh/core": "0.12.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.18.0"
}
