{
  "name": "@xec-sh/cli",
  "description": "CLI for running commands, scripts, and tasks on local, SSH, Docker, and Kubernetes targets",
  "version": "0.11.1",
  "author": "LuxQuant",
  "type": "module",
  "license": "MIT",
  "directories": {
    "bin": "./bin",
    "dist": "./dist"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "globals.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./globals": {
      "types": "./globals.d.ts",
      "import": "./dist/globals.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "cli",
    "shell",
    "typescript",
    "automation",
    "devops",
    "ssh",
    "docker",
    "kubernetes",
    "orchestration",
    "scripting"
  ],
  "scripts": {
    "build": "rm -rf dist node_modules/.tmp/tsconfig.tsbuildinfo && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.tmp/tsconfig.tsbuildinfo"
  },
  "bin": {
    "xec": "bin/xec"
  },
  "dependencies": {
    "@xec-sh/core": "workspace:*",
    "@xec-sh/kit": "workspace:*",
    "@xec-sh/loader": "workspace:*",
    "@xec-sh/ops": "workspace:*",
    "commander": "^15.0.0",
    "fs-extra": "^11.4.1",
    "glob": "^14.0.3",
    "js-yaml": "^5.5.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/ssh2": "^1.15.6",
    "@xec-sh/testing": "workspace:*",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xec-sh/xec.git",
    "directory": "apps/xec"
  },
  "bugs": {
    "url": "https://github.com/xec-sh/xec/issues"
  },
  "homepage": "https://xec.sh",
  "engines": {
    "node": ">=22.18.0"
  }
}
