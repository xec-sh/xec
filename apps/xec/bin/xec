#!/usr/bin/env node

import { readFileSync } from 'node:fs';

const { engines } = JSON.parse(readFileSync(new URL('../package.json', import.meta.url), 'utf8'));
const minimum = /^>=(\d+)\.(\d+)\.(\d+)$/.exec(engines.node);
if (!minimum) throw new Error(`Unsupported Node.js requirement in Xec manifest: ${engines.node}`);
const current = process.versions.node.split('.').map(Number);
const required = minimum.slice(1).map(Number);
const difference = current.map((value, index) => value - required[index]).find(value => value !== 0) ?? 0;
if (difference < 0) {
  console.error(`Error: Xec requires Node.js ${engines.node}. You are using ${process.version}`);
  process.exit(1);
}

// Enable source map support for better error traces
try {
  await import('source-map-support/register');
} catch (e) {
  // Source map support is optional
}

// Load and run CLI
// `main`, not `run`: the entry point owes the operating system a Ctrl+C
// that works and a process that exits when the command is done. `run`
// does the work and returns.
import('../dist/main.js')
  .then(cli => cli.main())
  .catch(err => {
    if (err.code === 'MODULE_NOT_FOUND') {
      console.error('Error: Xec CLI is not built. Please run "pnpm build" first.');
    } else {
      console.error('Failed to start Xec CLI:', err.message || err);
      // Always show stack trace for debugging
      console.error('Stack trace:', err.stack);
    }
    process.exit(1);
  });
